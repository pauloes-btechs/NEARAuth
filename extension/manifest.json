{
  "manifest_version": 3,
  "name": "NEARAuth \u2014 Private Email Aliases (Demo)",
  "short_name": "NEARAuth",
  "version": "0.3.0",
  "description": "Prototype: generate a private email alias and a strong password in signup forms. Demo aliases by default; optional real forwarding and sender blocking through your own addy.io or SimpleLogin account.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NEARAuth",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "js": [
        "lib/generators.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "optional_host_permissions": [
    "https://app.addy.io/*",
    "https://app.simplelogin.io/*"
  ]
}
