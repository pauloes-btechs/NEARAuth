{
  "manifest_version": 3,
  "name": "NEARAuth — Private Email Aliases (Demo)",
  "short_name": "NEARAuth",
  "version": "0.1.0",
  "description": "Demo prototype: generate a private, non-routable demo email alias and a strong password in signup forms. Nothing is submitted or uploaded.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "NEARAuth",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["lib/generators.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
