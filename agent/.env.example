# Copy to .env (never commit .env). Everything is optional; defaults run a zero-setup simulation.
# NEARAUTH_AGENT_HOST=127.0.0.1
# NEARAUTH_AGENT_PORT=8787
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/nearauth_agent   # unset = embedded PGlite in .data/
# NEARAUTH_PROVIDER=mock            # or simplelogin (loopback only)
# SIMPLELOGIN_API_KEY=              # only with NEARAUTH_PROVIDER=simplelogin; kept in process memory only
# NEARAUTH_LLM=off                  # or ollama
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
# NEARAUTH_EMBEDDINGS=hash          # or ollama (with NEARAUTH_LLM=ollama)
# NEARAUTH_ALLOWED_ORIGINS=https://pauloes-btechs.github.io,http://localhost:8080
